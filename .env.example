MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://docker-learning-frontend-react.onrender.com

# Auth — generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

# ── AI Understand layer ──────────────────────────────────────────
# AI_PROVIDER = openai | groq | grok | gemini | openrouter | ollama | local
# Recommended free start: groq
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# Free tier (best for MVP): https://console.groq.com/keys
GROQ_API_KEY=

# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.0-flash

# Paid / quota: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini

# xAI Grok: https://console.x.ai/
XAI_API_KEY=
# AI_PROVIDER=grok
# AI_MODEL=grok-2-latest

# OpenRouter (many models, some free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# AI_PROVIDER=openrouter
# AI_MODEL=google/gemini-2.0-flash-exp:free

# Local free (install Ollama): https://ollama.com
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
